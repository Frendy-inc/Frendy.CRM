@using Frendy.CRM.Components.Components
@using Frendy.CRM.Shared.Enums
@using Frendy.CRM.Shared.Extensions
@using Frendy.Shared.Extensions
@inherits CustomComponentBase

<ModalBase IsOpen="AppState.UserModalState"
           Title="@LocalizationService.GetString("USER_MODAL_TITLE")"
           OnClose="Close">
    <CopyField Label="@LocalizationService.GetString("AUDIT_MODAL_ID")" Value="@UserDetails!.Id.ToString()"/>
    <div class="modal-person-info">
        <div class="modal-person-info-container">
            <div class="modal-person-avatar">
                @* TODO: На белой теме посмотреть как светится аватарка *@
                @if (!UserDetails.Avatar.IsNullOrEmpty())
                {
                    <Icon IconUrl="@UserDetails.Avatar" Size="IconSize.XXXL" Style="border-radius: 50%; filter: blur(0.5rem);"/>
                    <Icon IconUrl="@UserDetails.Avatar" Size="IconSize.XXXL" Style="border-radius: 50%; position: absolute; left: 1.5rem;"/>
                }
                else
                {
                    <Icon IconType="Icons.UserAvatar" Size="IconSize.XXXL" Color="var(--title-text-color)"/>
                }
            </div>
            <div class="modal-person-info-name">
                <div class="modal-person-info-name-container">
                    <span>@($"{UserDetails.LastName} {UserDetails.FirstName}")</span>
                    @if (!UserDetails.Username.IsNullOrEmpty())
                    {
                        <span class="status purple bg">@UserDetails.Username</span>
                    }
                </div>
                <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_ROLE_TITLE")"
                                Value="@UserDetails.Role.GetLocalization(LocalizationService)"/>
            </div>
        </div>
        <div class="modal-person-status">
            <span class="status @(UserDetails.IsOnline ? "positive" : "negative") bg">
                @(LocalizationService.GetString(UserDetails.IsOnline ? "USER_IS_ONLINE_TITLE" : "USER_IS_OFFLINE_TITLE"))
            </span>
            <span class="status @(UserDetails.IsBanned ? "negative" : "positive") bg">
                @(LocalizationService.GetString(UserDetails.IsBanned ? "USER_IS_BANNED_TITLE" : "USER_IS_NOT_BANNED_TITLE"))
            </span>
        </div>
    </div>
    <hr class="horizontal"/>
    <ModalSection>
        <IconLabelTitle Icon="Icons.Phone" Size="IconSize.M" Text="@LocalizationService.GetString("CONTACT_INFORMATION")"/>
        <ModalRow>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Email" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_EMAIL_TITLE")"
                                Value="@(UserDetails.Email ?? LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
                <IconLabelValue Icon="Icons.Phone" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_PHONE_NUMBER_TITLE")"
                                Value="@(!UserDetails.PhoneNumber.IsNullOrEmpty() ? UserDetails.PhoneNumber!.FormatPhone() : LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
                <IconLabelValue Icon="Icons.Key" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_AUTH_TYPE_TITLE")"
                                Value="@UserDetails.AuthType.GetLocalization(LocalizationService)"
                                ValueClass="@AuthTypeStyle"/>
            </ModalColumn>
            <hr class="vertical"/>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Date" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_BIRTHDAY")"
                                Value="@UserDetails.Birthday.GetStringDate()"
                                Description="@($"({Age} {GetYearsText(Age)})")"/>
                <IconLabelValue Icon="Icons.Date" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_REGISTRATION_DATE")"
                                Value="@UserDetails.CreatedAt.GetStringDate(withTime: true)"/>
            </ModalColumn>
        </ModalRow>
    </ModalSection>
    <hr class="horizontal"/>
    <ModalSection>
        <IconLabelTitle Icon="Icons.Computer" Size="IconSize.M" Text="@LocalizationService.GetString("USER_ACTIVITY_AND_DEVICES")"/>
        <ModalRow>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Clock" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_LAST_ACTIVITY_TITLE")"
                                Value="@UserDetails.LastActivity.GetStringDate(withTime: true)"/>
                <IconLabelValue Icon="Icons.Computer" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_DEVICE")"
                                Value="@UserDetails.DeviceName"/>
            </ModalColumn>
            <hr class="vertical"/>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Map" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_CITY")"
                                Value="@UserDetails.City"/>
                <IconLabelValue Icon="Icons.Network" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="IP"
                                Value="@UserDetails.IpAddress"/>
            </ModalColumn>
        </ModalRow>
    </ModalSection>
</ModalBase>