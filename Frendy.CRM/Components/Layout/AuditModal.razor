@using Frendy.CRM.Components.Buttons
@using Frendy.CRM.Components.Components
@using Frendy.CRM.Shared
@using Frendy.CRM.Shared.Enums
@using Frendy.CRM.Shared.Extensions
@using Frendy.Shared.Extensions
@inherits CustomComponentBase

<div class="modal-bg @(AppState.ActionModalState ? "show" : "")">
    <div class="modal-container">
        <div class="modal-header">
            <span style="font-weight: 700;">@LocalizationService.GetString("AUDIT_MODAL_TITLE")</span>
            <IconButton Icon="Icons.Close" Size="IconSize.Small" OnClick="Close"/>
        </div>
        <div class="modal-content">
            <div class="modal-id">
                <div class="modal-id-info">
                    <span style="font-weight: 700;">@LocalizationService.GetString("AUDIT_MODAL_ID")</span>
                    <span>@(AuditDetails.Id)</span>
                </div>
                <IconButton Icon="Icons.Copy" Size="IconSize.Small" OnClick="Copy"/>
            </div>
            <div class="modal-action-time">
                <span class="unfocus">@LocalizationService.GetString("AUDIT_MODAL_ACTION_DATE")</span>
                <span>@(AuditDetails.ActionDate.ToString("dd.MM.yyyy hh:mm"))</span>
            </div>
            <hr class="horizontal"/>
            <div class="modal-person">
                <div class="modal-person-title">
                    <div class="modal-person-square-icon">
                        <Icon IconType="Icons.Profile" Size="IconSize.Medium"/>
                    </div>
                    <span style="font-weight: 700;">@LocalizationService.GetString("AUDIT_MODAL_EXECUTOR")</span>
                </div>
                <div class="modal-person-info">
                    <div class="modal-person-info-name">
                        <div class="modal-person-circle-icon">
                            <Icon IconType="Icons.Profile" Size="IconSize.Small"/>
                        </div>
                        <span>@($"{AuditDetails.ExecutorFirstName} {AuditDetails.ExecutorLastName}")</span>
                        <span class="unfocus">@(AuditDetails.ExecutorRole.GetLocalization(LocalizationService))</span>
                    </div>
                    @if (!AuditDetails.Email.IsNullOrEmpty())
                    {
                        <div class="modal-person-info-elem">
                            <hr class="vertical"/>
                            <span class="unfocus">@(AuditDetails.Email)</span>
                        </div>
                    }
                    <div class="modal-person-info-elem">
                        <hr class="vertical"/>
                        <span class="unfocus">@($"{AuditDetails.DeviceName}, {AuditDetails.City}")</span>
                    </div>
                </div>
            </div>
            <hr class="horizontal"/>
            <div class="modal-person">
                <div class="modal-person-title">
                    <div class="modal-person-square-icon">
                        <Icon IconType="Icons.Profile" Size="IconSize.Medium"/>
                    </div>
                    <span style="font-weight: 700;">@LocalizationService.GetString("AUDIT_MODAL_TARGET")</span>
                </div>
                <div class="modal-person-info">
                    <div class="modal-person-info-name">
                        <div class="modal-person-circle-icon">
                            <Icon IconType="Icons.Profile" Size="IconSize.Small"/>
                        </div>
                        <span>@($"{AuditDetails.TargetFirstName} {AuditDetails.TargetLastName}")</span>
                        <span class="unfocus">@(AuditDetails.TargetRole.GetLocalization(LocalizationService))</span>
                    </div>
                </div>
            </div>
            <hr class="horizontal"/>
            <div class="modal-person">
                <div class="modal-person-title">
                    <div class="modal-person-square-icon @(AuditDetails.Action.GetActionClass())">
                        <Icon IconType="Icons.Tag" Size="IconSize.Medium" Color="@_iconStatusStyle"/>
                    </div>
                    <span style="font-weight: 700;">@LocalizationService.GetString("AUDIT_MODAL_ACTION_TYPE")</span>
                </div>
                <div class="modal-person-info">
                    <div class="modal-person-info-elem">
                        <hr class="vertical"/>
                        <span style="font-weight: 700;" class="@(AuditDetails.Action.GetActionClass())">@(AuditDetails.Action.GetLocalization(LocalizationService))</span>
                    </div>
                    @if (!AuditDetails.ActionDescription.IsNullOrEmpty())
                    {
                        <div class="modal-person-info-elem">
                            <hr class="vertical"/>
                            <span class="unfocus">@(AuditDetails.ActionDescription)</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>