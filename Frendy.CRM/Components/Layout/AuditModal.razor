@using Frendy.CRM.Components.Components
@using Frendy.CRM.Shared.Enums
@using Frendy.CRM.Shared.Extensions
@using Frendy.Shared.Extensions
@inherits CustomComponentBase

<ModalBase IsOpen="AppState.ActionModalState"
           Title="@LocalizationService.GetString("AUDIT_MODAL_TITLE")"
           OnClose="Close">
    <CopyField Label="@LocalizationService.GetString("AUDIT_MODAL_ID")" Value="@AuditDetails!.Id.ToString()" />
    <ModalSection>
        <IconLabelTitle Icon="Icons.Profile" Size="IconSize.M" Text="@LocalizationService.GetString("AUDIT_MODAL_EXECUTOR")"/>
        <ModalRow>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_NAME_TITLE")"
                                Value="@($"{AuditDetails.ExecutorLastName} {AuditDetails.ExecutorFirstName}")"/>
                <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_ROLE_TITLE")"
                                Value="@(AuditDetails.ExecutorRole.GetLocalization(LocalizationService))"/>
                <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_USERNAME")"
                                Value="@(AuditDetails.ExecutorUsername)"
                                ValueClass="status purple bg"/>
                <IconLabelValue Icon="Icons.Email" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_EMAIL_TITLE")"
                                Value="@(AuditDetails.ExecutorEmail ?? LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
                <IconLabelValue Icon="Icons.Phone" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_PHONE_NUMBER_TITLE")"
                                Value="@(!AuditDetails.ExecutorPhoneNumber.IsNullOrEmpty()
                                           ? AuditDetails.ExecutorPhoneNumber!.FormatPhone()
                                           : LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
            </ModalColumn>
            <hr class="vertical"/>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Computer" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_DEVICE")"
                                Value="@AuditDetails.ExecutorDeviceName"/>
                <IconLabelValue Icon="Icons.Map" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_CITY")"
                                Value="@AuditDetails.ExecutorCity"/>
                <IconLabelValue Icon="Icons.Network" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="IP"
                                Value="@AuditDetails.ExecutorIpAddress"/>
            </ModalColumn>
        </ModalRow>
    </ModalSection>
    <hr class="horizontal"/>
    <ModalSection>
        <IconLabelTitle Icon="Icons.Profile" Size="IconSize.M" Text="@LocalizationService.GetString("AUDIT_MODAL_TARGET")"/>
        <ModalRow>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_NAME_TITLE")"
                                Value="@($"{AuditDetails.TargetLastName} {AuditDetails.TargetFirstName}")"/>
                <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_ROLE_TITLE")"
                                Value="@(AuditDetails.TargetRole.GetLocalization(LocalizationService))"/>
                <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_USERNAME")"
                                Value="@(AuditDetails.TargetUsername)"
                                ValueClass="status purple bg"/>
            </ModalColumn>
            <hr class="vertical"/>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Email" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_EMAIL_TITLE")"
                                Value="@(AuditDetails.TargetEmail ?? LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
                <IconLabelValue Icon="Icons.Phone" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("USER_PHONE_NUMBER_TITLE")"
                                Value="@(!AuditDetails.TargetPhoneNumber.IsNullOrEmpty()
                                           ? AuditDetails.TargetPhoneNumber!.FormatPhone()
                                           : LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
            </ModalColumn>
        </ModalRow>
    </ModalSection>
    <hr class="horizontal"/>
    <ModalSection>
        <IconLabelTitle Icon="Icons.Tag" Size="IconSize.M" IconColor="@_iconStatusStyle"
                        IconClass="@(AuditDetails.Action.GetStyleClass())"
                        Text="@LocalizationService.GetString("AUDIT_MODAL_ACTION_INFO")"/>
        <ModalRow>
            <ModalColumn>
                <IconLabelValue Icon="Icons.Tag" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("TABLE_ACTION_TITLE")"
                                Value="@(AuditDetails.Action.GetLocalization(LocalizationService))"
                                ValueClass="@_actionTypeClass"/>
                <IconLabelValue Icon="Icons.Text" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("ACTION_DESCRIPTION")"
                                Value="@(AuditDetails.ActionDescription ?? LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
                <IconLabelValue Icon="Icons.Clock" Size="IconSize.S" Color="var(--unfocus-color)"
                                Label="@LocalizationService.GetString("AUDIT_MODAL_ACTION_DATE")"
                                Value="@(AuditDetails.ActionDate.GetStringDate(withTime: true))"/>
            </ModalColumn>
        </ModalRow>
    </ModalSection>
</ModalBase>