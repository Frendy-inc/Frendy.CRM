@using Frendy.CRM.Components.Components
@inherits LayoutComponentBase

<div class="page">
    <main>
        <StartLoader IsLoading="_isLoading"/>
        <LoaderHost/>
        <NotificationHost/>
        <ModalHost/>
        <Header OnToggleNavMenu="ToggleNavMenuState" OnToggleUserMenu="ToggleUserMenuState"></Header>
        <UserMenu IsCollapsed="@_userMenuIsCollapsed"/>
        <article class="content px-4">
            <NavMenu IsCollapsed="@_navMenuIsCollapsed"/>
            <div class="body-content">
                @Body
            </div>
        </article>
    </main>
</div>