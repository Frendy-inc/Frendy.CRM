@using Frendy.CRM.Components.Buttons
@using Frendy.CRM.Components.Components
@using Frendy.CRM.Shared.Enums
@using Frendy.Shared.Extensions
@inherits CustomComponentBase

<div class="header-content">
    <div class="burger-content">
        <IconButton Icon="Icons.Burger" Size="IconSize.M" Color="var(--title-text-color)" OnClick="@OnBurgerClicked" />
    </div>

    <div class="crm-info">
        <span class="crm-title">Frendy CRM</span>
        <span class="crm-version">v1.0</span>   
    </div>

    <div class="user-info-container">
        <div class="user-info">
            <span class="user-name">@FullName</span>
            <span class="user-role">@Role</span>
        </div>
        <div class="user-menu">
            @if (!Avatar.IsNullOrEmpty())
            {
                <Icon IconUrl="@Avatar" Size="IconSize.XL" Style="border-radius: 32rem;"/>
            }
            else
            {
                <Icon IconType="Icons.UserAvatar" Size="IconSize.XL" Color="var(--title-text-color)"/>
            }
            <IconButton Icon="Icons.DownArrow" Size="IconSize.S" Color="var(--title-text-color)" OnClick="@OnExpandClicked"/>
        </div>
    </div>
</div>