@using Frendy.CRM.Components.Buttons
@using Frendy.CRM.Shared.Enums

@if (_isOpen && _componentType != null)
{
    <div class="modal-bg show" @onclick="Close">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span style="font-weight:700;">@_title</span>
                <IconButton Icon="Icons.Close"
                            Size="IconSize.S"
                            OnClick="Close" />
            </div>

            <div class="modal-content">
                <DynamicComponent Type="_componentType"
                                  Parameters="_parameters" />
            </div>
        </div>
    </div>
}