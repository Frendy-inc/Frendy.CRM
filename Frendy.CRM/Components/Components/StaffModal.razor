@using Frendy.CRM.Components.Buttons
@using Frendy.CRM.Components.Components
@using Frendy.CRM.Shared.Enums
@using Frendy.CRM.Shared.Extensions
@using Frendy.Shared.Extensions
@inherits CustomComponentBase

<CopyField Label="@LocalizationService.GetString("AUDIT_MODAL_ID")" Value="@Model!.Id.ToString()"/>
<PersonCard AvatarUrl="@Model.Avatar" FirstName="@Model.FirstName" LastName="@Model.LastName"
                 Username="@Model.Username" Role="@Model.Role" IsOnline="@Model.IsOnline" 
                 IsBanned="@Model.IsBanned"/>
<hr class="horizontal"/>
<Section>
    <IconLabelTitle Icon="Icons.Phone" Size="IconSize.M" Text="@LocalizationService.GetString("CONTACT_INFORMATION")"/>
    <Row>
        <Column>
            <IconLabelValue Icon="Icons.Email" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_EMAIL_TITLE")"
                            Value="@(Model.Email ?? LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
        </Column>
        <hr class="vertical"/>
        <Column>
            <IconLabelValue Icon="Icons.Phone" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_PHONE_NUMBER_TITLE")"
                            Value="@(!Model.PhoneNumber.IsNullOrEmpty() ? Model.PhoneNumber!.FormatPhone() : LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
        </Column>
    </Row>
</Section>
<hr class="horizontal"/>
<Section>
    <IconLabelTitle Icon="Icons.Computer" Size="IconSize.M" Text="@LocalizationService.GetString("USER_ACTIVITY_AND_DEVICES")"/>
    <Row>
        <Column>
            <IconLabelValue Icon="Icons.Clock" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_LAST_ACTIVITY_TITLE")"
                            Value="@Model.LastActivity.GetStringDate(withTime: true)"/>
        </Column>
        <hr class="vertical"/>
        <Column>
            <IconLabelValue Icon="Icons.Computer" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_DEVICE")"
                            Value="@Model.DeviceName"/>
        </Column>
    </Row>
</Section>
<hr class="horizontal"/>
<Section>
    <IconLabelTitle Icon="Icons.Profile" Size="IconSize.M" Text="@LocalizationService.GetString("USER_ROLE_ASSIGNER")"/>
    <Row>
        <Column>
            <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_NAME_TITLE")"
                            Value="@($"{Model.AssignerLastName} {Model.AssignerFirstName}")"/>
            <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_ROLE_TITLE")"
                            Value="@(Model.AssignerRole.GetLocalization(LocalizationService))"/>
            <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_USERNAME")"
                            Value="@(Model.AssignerUsername)"
                            ValueClass="status purple bg"/>
        </Column>
        <hr class="vertical"/>
        <Column>
            <IconLabelValue Icon="Icons.Email" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_EMAIL_TITLE")"
                            Value="@(Model.AssignerEmail ?? LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
            <IconLabelValue Icon="Icons.Phone" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_PHONE_NUMBER_TITLE")"
                            Value="@(!Model.AssignerPhoneNumber.IsNullOrEmpty()
                                       ? Model.AssignerPhoneNumber!.FormatPhone()
                                       : LocalizationService.GetString("TABLE_NO_SPECIFIED"))"/>
        </Column>
    </Row>
</Section>
<hr class="horizontal"/>
<Section>
    <Row>
        <TextButton OnClick="OnDemoteClick" Color="var(--negative-primary-color)" Text="Разжаловать" />
        @* <TextButton OnClick="OnClose" Text="Сохранить" /> *@
    </Row>
</Section>