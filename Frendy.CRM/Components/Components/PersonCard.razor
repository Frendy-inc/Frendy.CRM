@using Frendy.CRM.Shared.Enums
@using Frendy.CRM.Shared.Extensions
@using Frendy.Shared.Extensions
@inherits CustomComponentBase

<div class="modal-person-info">
    <div class="modal-person-info-container">
        <div class="modal-person-avatar">
            @* TODO: На белой теме посмотреть как светится аватарка *@
            @if (!AvatarUrl.IsNullOrEmpty())
            {
                <Icon IconUrl="@AvatarUrl" Size="IconSize.XXXL" Style="border-radius: 50%; filter: blur(0.5rem);"/>
                <Icon IconUrl="@AvatarUrl" Size="IconSize.XXXL" Style="border-radius: 50%; position: absolute; left: 1.5rem;"/>
            }
            else
            {
                <Icon IconType="Icons.UserAvatar" Size="IconSize.XXXL" Color="var(--title-text-color)"/>
            }
        </div>
        <div class="modal-person-info-name">
            <div class="modal-person-info-name-container">
                <span>@($"{LastName} {FirstName}")</span>
                @if (!Username.IsNullOrEmpty())
                {
                    <span class="status purple bg">@Username</span>
                }
            </div>
            <IconLabelValue Icon="Icons.Profile" Size="IconSize.S" Color="var(--unfocus-color)"
                            Label="@LocalizationService.GetString("USER_ROLE_TITLE")"
                            Value="@Role.GetLocalization(LocalizationService)"/>
        </div>
    </div>
    <div class="modal-person-status">
        <span class="status @(IsOnline ? "positive" : "negative") bg">
            @(LocalizationService.GetString(IsOnline ? "USER_IS_ONLINE_TITLE" : "USER_IS_OFFLINE_TITLE"))
        </span>
        <span class="status @(IsBanned ? "negative" : "positive") bg">
            @(LocalizationService.GetString(IsBanned ? "USER_IS_BANNED_TITLE" : "USER_IS_NOT_BANNED_TITLE"))
        </span>
    </div>
</div>